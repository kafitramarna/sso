# SSO environment — copy to deploy/.env (gitignored), fill values.
# Never commit real credentials.
#
# Dev (docker-compose.dev.yml) needs NOTHING below — appsettings.Development.json
# already mirrors the dev compose values. Everything here is for the production
# docker-compose.yml (PRD §11).

# ── Domain / issuer ─────────────────────────────────────────────────────
DOMAIN=sso.example.com            # sso.<domain>; also the `iss` claim value
OFFICE_DOMAIN=office.example.com  # agent-office origin → CORS + redirect_uri seed

# ── Data plane ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                # generate: openssl rand -hex 24
REDIS_PASSWORD=                   # generate: openssl rand -hex 24

# ── Signing (KD-02): RSA-2048 khusus SSO, di-mount sebagai file ──────────
# Generate sekali:  openssl genrsa -out deploy/signing/sso-rsa.pem 2048
#                   openssl rsa -in deploy/signing/sso-rsa.pem -pubout -out deploy/signing/sso-rsa.pub
# deploy/signing/ is gitignored — backup the key securely off-repo.
SIGNING_KEY_PATH=/run/secrets/signing_key   # atau path file PEM di container

# ── Bootstrap admin pertama (KD-11) — dipakai SEKALI saat DB kosong ──────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=              # min 12 chars (PasswordPolicy)

# ── Client seed: agent-office (KD-08, confidential) ──────────────────────
SEED_AGENTOFFICE_CLIENT_SECRET=   # generate: openssl rand -hex 32 — shown once, store it

# ── Email (KD-10): Resend via SMTP relay ─────────────────────────────────
EMAIL_PROVIDER=smtp               # smtp | console (console → log saja)
EMAIL_FROM=SSO <sso@yourdomain.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=resend
SMTP_PASS=                        # RESEND_API_KEY

# Opsional
# REDIS_MAXMEMORY=256mb
# ALLOW_SELF_REGISTRATION=false   # KD-09 — produksi tetap false (invite-only)
